generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/allblue-client"
}

datasource db {
  provider = "mysql"
  url      = env("ALLBLUE_DATABASE_URL")
}

model user {
  id           Int             @id @default(autoincrement())
  userId       String          @unique(map: "uk_userId") @db.VarChar(50)
  password     String          @db.VarChar(255)
  userName     String          @db.VarChar(50)
  email        String?         @db.VarChar(100)
  phone        String?         @db.VarChar(20)
  userType     String          @default("instructor") @db.VarChar(20)
  status       String          @default("pending") @db.VarChar(20)
  kakaoId      String?         @unique @db.VarChar(50)
  googleId     String?         @unique @db.VarChar(50)
  naverId      String?         @unique @db.VarChar(50)
  appleId      String?         @unique @db.VarChar(50)
  profileImage String?         @db.VarChar(500)
  birthDate    String?         @db.VarChar(20)
  kakaoTalkId  String?         @db.VarChar(50)
  instagramId  String?         @db.VarChar(50)
  smbAddress   String?         @db.VarChar(255)
  smbAccount   String?         @db.VarChar(100)
  smbPassword  String?         @db.VarChar(255)
  refreshToken String?         @db.VarChar(500)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  lastLoginAt  DateTime?
  loginHistory login_history[]
  profile      user_profile?
}

model login_history {
  id        BigInt   @id @default(autoincrement())
  userId    Int
  result    String   @db.VarChar(20)
  ipAddress String?  @db.VarChar(45)
  createdAt DateTime @default(now())
  user      user     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model user_profile {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique(map: "uk_user_profile_userId") @map("user_id")
  diverLevel  String?  @map("diver_level") @db.VarChar(20)
  description String?  @db.Text
  shoesSize   Int?     @map("shoes_size")
  finSize     String?  @map("fin_size") @db.VarChar(10)
  sta         Decimal? @db.Decimal(6, 2)
  dynb        Decimal? @db.Decimal(6, 2)
  dyn         Decimal? @db.Decimal(6, 2)
  dnf         Decimal? @db.Decimal(6, 2)
  fim         Decimal? @db.Decimal(6, 2)
  cwtb        Decimal? @db.Decimal(6, 2)
  cwt         Decimal? @db.Decimal(6, 2)
  cnf         Decimal? @db.Decimal(6, 2)
  level       Int?     @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  user        user     @relation(fields: [userId], references: [id])
}

model form_item {
  id           Int      @id @default(autoincrement())
  instructorId Int?
  formId       String   @db.VarChar(50)
  seq          Int
  content      String   @db.Text
  itemType     String   @db.VarChar(50)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([formId, instructorId, seq])
}

model form_submission {
  id           Int      @id @default(autoincrement())
  uuid         String   @unique @db.VarChar(36)
  instructorId Int
  formId       String   @db.VarChar(50)
  diverName    String   @db.VarChar(50)
  instructorName String?  @db.VarChar(50)
  status             String   @default("pending") @db.VarChar(20)
  printed            Int      @default(0)
  checkboxData       Json?
  checkboxDetailData Json?
  birthDate          String?  @db.VarChar(20)
  signDate           String?  @db.VarChar(20)
  signatureData      String?  @db.VarChar(500)
  guardianSignature   String?  @db.VarChar(100)
  doctorName          String?  @db.VarChar(100)
  doctorSignatureData String?  @db.VarChar(500)
  doctorDate          String?  @db.VarChar(20)
  doctorPhone         String?  @db.VarChar(30)
  doctorAddress       String?  @db.VarChar(255)
  doctorAddressDetail String?  @db.VarChar(255)
  doctorChecks        Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([instructorId])
}

model instructor_register_request {
  id           Int      @id @default(autoincrement())
  userId       String   @db.VarChar(50)
  name         String   @db.VarChar(50)
  phone        String?  @db.VarChar(20)
  kakaoId      String?  @db.VarChar(50)
  instaId      String?  @db.VarChar(50)
  password     String?  @db.VarChar(255)
  isInstructor Int      @default(0) @db.TinyInt
  certImageUrl String?  @db.VarChar(500)
  status       String   @default("pending") @db.VarChar(20)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
