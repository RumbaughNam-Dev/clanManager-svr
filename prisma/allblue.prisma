generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/allblue-client"
}

datasource db {
  provider = "mysql"
  url      = env("ALLBLUE_DATABASE_URL")
}

model user {
  id           Int             @id @default(autoincrement())
  userId       String          @unique(map: "uk_userId") @db.VarChar(50)
  password     String          @db.VarChar(255)
  userName     String?         @db.VarChar(50)
  nickname     String          @db.VarChar(50)
  email        String?         @db.VarChar(100)
  phone        String?         @db.VarChar(20)
  userType     String          @default("instructor") @db.VarChar(20)
  status       String          @default("pending") @db.VarChar(20)
  kakaoId      String?         @unique @db.VarChar(50)
  googleId     String?         @unique @db.VarChar(50)
  naverId      String?         @unique @db.VarChar(50)
  appleId      String?         @unique @db.VarChar(50)
  profileImage String?         @db.VarChar(500)
  birthDate    String?         @db.VarChar(20)
  kakaoTalkId  String?         @db.VarChar(50)
  instagramId  String?         @db.VarChar(50)
  smbAddress   String?         @db.VarChar(255)
  smbAccount   String?         @db.VarChar(100)
  smbPassword  String?         @db.VarChar(255)
  refreshToken String?         @db.VarChar(500)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  lastLoginAt  DateTime?
  loginHistory login_history[]
  profile                 user_profile?
  certRequests            cert_request[]
  schedules               schedule[]               @relation("schedule_instructor")
  participations          schedule_participant[]
  achievements            user_license_achievement[] @relation("achievement_user")
  instructedAchievements  user_license_achievement[] @relation("achievement_instructor")
}

model login_history {
  id        BigInt   @id @default(autoincrement())
  userId    Int
  result    String   @db.VarChar(20)
  ipAddress String?  @db.VarChar(45)
  createdAt DateTime @default(now())
  user      user     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model user_profile {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique(map: "uk_user_profile_userId") @map("user_id")
  diverLevel  String?  @map("diver_level") @db.VarChar(20)
  description String?  @db.Text
  shoesSize   Int?     @map("shoes_size")
  finSize     String?  @map("fin_size") @db.VarChar(10)
  sta         Decimal? @db.Decimal(6, 2)
  dynb        Decimal? @db.Decimal(6, 2)
  dyn         Decimal? @db.Decimal(6, 2)
  dnf         Decimal? @db.Decimal(6, 2)
  fim         Decimal? @db.Decimal(6, 2)
  cwtb        Decimal? @db.Decimal(6, 2)
  cwt         Decimal? @db.Decimal(6, 2)
  cnf         Decimal? @db.Decimal(6, 2)
  level       String?  @db.VarChar(2)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  user        user     @relation(fields: [userId], references: [id])
}

model form_item {
  id           Int      @id @default(autoincrement())
  instructorId Int?
  formId       String   @db.VarChar(50)
  seq          Int
  content      String   @db.Text
  itemType     String   @db.VarChar(50)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([formId, instructorId, seq])
}

model form_submission {
  id           Int      @id @default(autoincrement())
  uuid         String   @unique @db.VarChar(36)
  instructorId Int
  formId       String   @db.VarChar(50)
  diverName    String   @db.VarChar(50)
  instructorName String?  @db.VarChar(50)
  status             String   @default("pending") @db.VarChar(20)
  printed            Int      @default(0)
  checkboxData       Json?
  checkboxDetailData Json?
  birthDate          String?  @db.VarChar(20)
  signDate           String?  @db.VarChar(20)
  signatureData      String?  @db.VarChar(500)
  guardianSignature   String?  @db.VarChar(100)
  doctorName          String?  @db.VarChar(100)
  doctorSignatureData String?  @db.VarChar(500)
  doctorDate          String?  @db.VarChar(20)
  doctorPhone         String?  @db.VarChar(30)
  doctorAddress       String?  @db.VarChar(255)
  doctorAddressDetail String?  @db.VarChar(255)
  doctorChecks        Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([instructorId])
}

model cert_request {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  imageUrl  String   @map("image_url") @db.VarChar(500)
  status       String   @default("pending") @db.VarChar(20)
  rejectReason String?  @map("reject_reason") @db.VarChar(200)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         user     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model diving_pool {
  id           Int       @id @default(autoincrement()) @db.UnsignedInt
  name         String    @db.VarChar(100)
  nameEn       String?   @map("name_en") @db.VarChar(150)
  region       String?   @db.VarChar(20)
  sigungu      String?   @db.VarChar(30)
  address      String?   @db.VarChar(200)
  phone        String?   @db.VarChar(20)
  phoneAlt     String?   @map("phone_alt") @db.VarChar(20)
  depthM       Decimal?  @map("depth_m") @db.Decimal(4, 1)
  isIndoor     Int       @default(1) @map("is_indoor") @db.TinyInt
  poolType     String    @default("DEEP_POOL") @map("pool_type") @db.VarChar(20)
  latitude     Decimal?  @db.Decimal(10, 7)
  longitude    Decimal?  @db.Decimal(10, 7)
  kakaoMapUrl  String?   @map("kakao_map_url") @db.VarChar(400)
  website      String?   @db.VarChar(200)
  status       String    @default("OPERATING") @db.VarChar(20)
  note         String?   @db.VarChar(500)
  sourceUrl    String?   @map("source_url") @db.VarChar(300)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  schedules    schedule[]
}

model schedule {
  id            Int                    @id @default(autoincrement()) @db.UnsignedInt
  title         String                 @db.VarChar(100)
  scheduleDate  DateTime               @map("schedule_date") @db.Date
  startHour     Int                    @map("start_hour") @db.UnsignedTinyInt
  startMinute   Int                    @map("start_minute") @db.UnsignedTinyInt
  poolId        Int?                   @map("pool_id") @db.UnsignedInt
  categoryCode  String                 @map("category_code") @db.VarChar(30)
  instructorId  String                 @map("instructor_id") @db.VarChar(50)
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")
  pool          diving_pool?           @relation(fields: [poolId], references: [id])
  instructor    user                   @relation("schedule_instructor", fields: [instructorId], references: [userId])
  participants  schedule_participant[]
}

model schedule_participant {
  id          Int      @id @default(autoincrement()) @db.UnsignedInt
  scheduleId  Int      @map("schedule_id") @db.UnsignedInt
  userId      String   @map("user_id") @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at")
  schedule    schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  user        user     @relation(fields: [userId], references: [userId])

  @@unique([scheduleId, userId], map: "uk_schedule_user")
}

model user_license_achievement {
  id            Int       @id @default(autoincrement()) @db.UnsignedInt
  userId        Int       @map("user_id")
  requirementId Int       @map("requirement_id") @db.UnsignedInt
  isCompleted   Int       @default(0) @map("is_completed") @db.TinyInt
  completedAt   DateTime? @map("completed_at")
  completedBy   Int?      @map("completed_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  user          user                @relation("achievement_user", fields: [userId], references: [id])
  requirement   license_requirement @relation(fields: [requirementId], references: [id])
  instructor    user?               @relation("achievement_instructor", fields: [completedBy], references: [id])

  @@unique([userId, requirementId], map: "uk_user_requirement")
}

model common_code {
  codeGroup   String   @map("code_group") @db.VarChar(30)
  code        String   @db.VarChar(30)
  name        String   @db.VarChar(100)
  nameKo      String?  @map("name_ko") @db.VarChar(100)
  sortOrder   Int      @default(0) @map("sort_order") @db.SmallInt
  isActive    Int      @default(1) @map("is_active") @db.TinyInt
  extraValue  String?  @map("extra_value") @db.VarChar(200)
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@id([codeGroup, code])
}

model association {
  id          Int       @id @default(autoincrement()) @db.UnsignedInt
  code        String    @unique(map: "uk_association_code") @db.VarChar(20)
  name        String    @db.VarChar(100)
  nameKo      String?   @map("name_ko") @db.VarChar(100)
  fullName    String?   @map("full_name") @db.VarChar(200)
  country     String?   @db.VarChar(50)
  foundedYear Int?      @map("founded_year") @db.SmallInt
  website     String?   @db.VarChar(200)
  sortOrder   Int       @default(0) @map("sort_order") @db.SmallInt
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  licenses    license[]
}

model license {
  id            Int                   @id @default(autoincrement()) @db.UnsignedInt
  associationId Int                   @map("association_id") @db.UnsignedInt
  code          String?               @db.VarChar(30)
  name          String                @db.VarChar(120)
  nameKo        String?               @map("name_ko") @db.VarChar(120)
  levelOrder    Int                   @map("level_order") @db.UnsignedTinyInt
  isInstructor  Int                   @default(0) @map("is_instructor") @db.TinyInt
  note          String?               @db.VarChar(500)
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")
  association   association           @relation(fields: [associationId], references: [id])
  requirements  license_requirement[]

  @@unique([associationId, levelOrder], map: "uk_license_assoc_level")
  @@index([associationId], map: "idx_license_assoc")
}

model license_requirement {
  id           Int                    @id @default(autoincrement()) @db.UnsignedInt
  licenseId    Int                    @map("license_id") @db.UnsignedInt
  parentId     Int?                   @map("parent_id") @db.UnsignedInt
  reqGroup     String                 @map("req_group") @db.VarChar(20)
  reqType      String                 @map("req_type") @db.VarChar(10)
  code         String?                @db.VarChar(20)
  name         String                 @db.VarChar(150)
  nameKo       String?                @map("name_ko") @db.VarChar(150)
  unit         String                 @default("NONE") @db.VarChar(10)
  minValue     Decimal?               @map("min_value") @db.Decimal(7, 2)
  maxValue     Decimal?               @map("max_value") @db.Decimal(7, 2)
  displayValue String?                @map("display_value") @db.VarChar(80)
  isOptional   Int                    @default(0) @map("is_optional") @db.TinyInt
  sourceType   String                 @default("OFFICIAL") @map("source_type") @db.VarChar(20)
  sortOrder    Int                    @default(0) @map("sort_order") @db.SmallInt
  note         String?                @db.VarChar(500)
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @updatedAt @map("updated_at")
  license      license                @relation(fields: [licenseId], references: [id])
  parent       license_requirement?   @relation("RequirementTree", fields: [parentId], references: [id])
  children     license_requirement[]  @relation("RequirementTree")
  achievements user_license_achievement[]

  @@index([licenseId, sortOrder], map: "idx_req_license")
  @@index([parentId], map: "idx_req_parent")
  @@index([code], map: "idx_req_code")
}

model instructor_register_request {
  id           Int      @id @default(autoincrement())
  userId       String   @db.VarChar(50)
  name         String   @db.VarChar(50)
  phone        String?  @db.VarChar(20)
  kakaoId      String?  @db.VarChar(50)
  instaId      String?  @db.VarChar(50)
  password     String?  @db.VarChar(255)
  isInstructor Int      @default(0) @db.TinyInt
  certImageUrl String?  @db.VarChar(500)
  status       String   @default("pending") @db.VarChar(20)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
